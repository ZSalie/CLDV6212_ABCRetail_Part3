@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2><i class="fas fa-tachometer-alt"></i> Admin Dashboard</h2>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-cog"></i> Store Management
                </h5>
            </div>
            <div class="card-body">
                <p class="lead">Welcome back, Administrator! Manage your store efficiently.</p>

                <div class="row">
                    <div class="col-md-3 mb-4">
                        <div class="card text-white bg-primary">
                            <div class="card-body text-center">
                                <i class="fas fa-users fa-3x mb-3"></i>
                                <h4>Customers</h4>
                                <p>Manage customer accounts</p>
                                <a asp-controller="Customer" asp-action="Index" class="btn btn-light stretched-link">Manage</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 mb-4">
                        <div class="card text-white bg-success">
                            <div class="card-body text-center">
                                <i class="fas fa-box fa-3x mb-3"></i>
                                <h4>Products</h4>
                                <p>Manage product catalog</p>
                                <a asp-controller="Product" asp-action="Index" class="btn btn-light stretched-link">Manage</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 mb-4">
                        <div class="card text-white bg-warning">
                            <div class="card-body text-center">
                                <i class="fas fa-list-alt fa-3x mb-3"></i>
                                <h4>Orders</h4>
                                <p>Manage all orders</p>
                                <a asp-controller="Order" asp-action="Manage" class="btn btn-light stretched-link">Manage</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3 mb-4">
                        <div class="card text-white bg-info">
                            <div class="card-body text-center">
                                <i class="fas fa-upload fa-3x mb-3"></i>
                                <h4>Uploads</h4>
                                <p>File management</p>
                                <a asp-controller="Upload" asp-action="Index" class="btn btn-light stretched-link">Manage</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <h5><i class="fas fa-bolt"></i> Quick Actions</h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <a asp-controller="Product" asp-action="Create" class="btn btn-outline-primary w-100">
                                <i class="fas fa-plus"></i> Add New Product
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a asp-controller="Customer" asp-action="Create" class="btn btn-outline-success w-100">
                                <i class="fas fa-user-plus"></i> Add New Customer
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a asp-controller="Order" asp-action="Create" class="btn btn-outline-warning w-100">
                                <i class="fas fa-plus-circle"></i> Create Order
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>