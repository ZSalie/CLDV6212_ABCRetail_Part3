@{
    ViewData["Title"] = "Customer Dashboard";
}

<h2><i class="fas fa-user-circle"></i> Customer Dashboard</h2>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-shopping-bag"></i> Shopping Center
                </h5>
            </div>
            <div class="card-body">
                <p class="lead">Welcome back, @Context.Session.GetString("Username")! Happy shopping!</p>

                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-primary">
                            <div class="card-body text-center">
                                <i class="fas fa-shopping-bag fa-3x mb-3"></i>
                                <h4>Shop Products</h4>
                                <p>Browse our collection</p>
                                <a asp-controller="Product" asp-action="Index" class="btn btn-light stretched-link">Shop Now</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-success">
                            <div class="card-body text-center">
                                <i class="fas fa-shopping-cart fa-3x mb-3"></i>
                                <h4>My Cart</h4>
                                <p>View shopping cart</p>
                                <a asp-controller="Cart" asp-action="Index" class="btn btn-light stretched-link">View Cart</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-4">
                        <div class="card text-white bg-warning">
                            <div class="card-body text-center">
                                <i class="fas fa-list-alt fa-3x mb-3"></i>
                                <h4>My Orders</h4>
                                <p>Track order history</p>
                                <a asp-controller="Order" asp-action="MyOrders" class="btn btn-light stretched-link">View Orders</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <h5><i class="fas fa-link"></i> Quick Access</h5>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary w-100">
                                <i class="fas fa-box"></i> All Products
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-success w-100">
                                <i class="fas fa-cart-shopping"></i> Shopping Cart
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Order" asp-action="MyOrders" class="btn btn-outline-warning w-100">
                                <i class="fas fa-history"></i> Order History
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Upload" asp-action="Index" class="btn btn-outline-info w-100">
                                <i class="fas fa-upload"></i> Upload Files
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>