@model IEnumerable<ABC_Retailers_Part3.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}

<h2><i class="fas fa-users"></i> Customers</h2>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-user-friends"></i> Customer Management
                </h5>
                <div class="mt-2">
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Add New Customer
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Surname</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Shipping Address</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in Model)
                                {
                                    <tr>
                                        <td><code>@customer.Id.Substring(0, 8)</code></td>
                                        <td>@customer.Name</td>
                                        <td>@customer.Surname</td>
                                        <td>@customer.Username</td>
                                        <td>@customer.Email</td>
                                        <td>@(customer.ShippingAddress.Length > 30 ? customer.ShippingAddress.Substring(0, 30) + "..." : customer.ShippingAddress)</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@customer.Id" class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <form asp-action="Delete" method="post" class="d-inline">
                                                    <input type="hidden" name="id" value="@customer.Id" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                                            onclick="return confirm('Are you sure you want to delete this customer?')">
                                                        <i class="fas fa-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-users fa-4x text-muted mb-3"></i>
                        <h4>No Customers Found</h4>
                        <p class="text-muted">Get started by adding your first customer</p>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Add First Customer
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>