@model IEnumerable<ABC_Retailers_Part3.Models.Order>
@{
    ViewData["Title"] = "All Orders";
}

<h2><i class="fas fa-list-alt"></i> All Orders</h2>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-shopping-cart"></i> Order Management
                </h5>
                <div class="mt-2">
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Create Order
                    </a>
                </div>
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Product</th>
                                    <th>Quantity</th>
                                    <th>Total Price</th>
                                    <th>Order Date</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in Model)
                                {
                                    <tr>
                                        <td><code>@order.Id.Substring(0, 8)</code></td>
                                        <td>@order.Username</td>
                                        <td>@order.ProductName</td>
                                        <td>@order.Quantity</td>
                                        <td>R @order.TotalPrice.ToString("F2")</td>
                                        <td>@order.OrderDateUtc.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <span class="badge
                                                        @(order.Status == OrderStatus.Completed ? "bg-success" :
                                                                                                    order.Status == OrderStatus.Processing ? "bg-warning" :
                                                                                                    order.Status == OrderStatus.Cancelled ? "bg-danger" : "bg-secondary")">
                                        @order.Status
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-info btn-sm">
                                            <i class="fas fa-eye"></i> Details
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form asp-action="Delete" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('Are you sure you want to delete this order?')">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                                                        }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="fas fa-list-alt fa-4x text-muted mb-3"></i>
                        <h4>No Orders Found</h4>
                        <p class="text-muted">Get started by creating your first order</p>
                        <a asp-action="Create" class="btn btn-primary">
                            <i class="fas fa-plus"></i> Create First Order
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>