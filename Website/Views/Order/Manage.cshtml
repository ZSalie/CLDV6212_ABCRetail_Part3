@model IEnumerable<Order>
@{
    ViewData["Title"] = "Manage Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tasks"></i> Manage Orders</h2>
    <div>
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="fas fa-list"></i> View All Orders
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create Order
        </a>
    </div>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Total Price</th>
                            <th>Order Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><code>@order.Id.Substring(0, 8)</code></td>
                                <td>@order.Username</td>
                                <td>@order.ProductName</td>
                                <td>@order.Quantity</td>
                                <td>R @order.TotalPrice.ToString("F2")</td>
                                <td>@order.OrderDateUtc.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <span class="badge
                                                @(order.Status == OrderStatus.Completed ? "bg-success" :
                                                                                    order.Status == OrderStatus.Processing ? "bg-warning" :
                                                                                    order.Status == OrderStatus.Cancelled ? "bg-danger" : "bg-secondary")">
                                @order.Status
                            </span>
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-success btn-sm"
                                        onclick="updateStatus('@order.Id', 'Completed')"
                                        title="Mark as Completed">
                                    <i class="fas fa-check"></i>
                                </button>
                                <button type="button" class="btn btn-warning btn-sm"
                                        onclick="updateStatus('@order.Id', 'Processing')"
                                        title="Mark as Processing">
                                    <i class="fas fa-cog"></i>
                                </button>
                                <button type="button" class="btn btn-danger btn-sm"
                                        onclick="updateStatus('@order.Id', 'Cancelled')"
                                        title="Cancel Order">
                                    <i class="fas fa-times"></i>
                                </button>
                                <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-info btn-sm" title="Edit Order">
                                    <i class="fas fa-edit"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="fas fa-tasks fa-4x text-muted mb-3"></i>
            <h3>No Orders to Manage</h3>
            <p class="text-muted">There are no orders in the system yet.</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Create First Order
            </a>
        </div>
    </div>
}

@section Scripts {
    <script>
        function updateStatus(orderId, newStatus) {
            if (confirm('Are you sure you want to update order status to "' + newStatus + '"?')) {
                $.post('@Url.Action("UpdateOrderStatus", "Order")', { id: orderId, newStatus: newStatus })
                    .done(function(response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    })
                    .fail(function() {
                        alert('Error updating order status');
                    });
            }
        }
    </script>
}