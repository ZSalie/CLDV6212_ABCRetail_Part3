@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="row justify-content-center">
    <div class="col-md-8 text-center">
        <div class="card">
            <div class="card-body py-5">
                <i class="fas fa-check-circle fa-5x text-success mb-4"></i>
                <h1 class="card-title">Order Confirmed!</h1>
                <p class="card-text lead">Thank you for your purchase, @Context.Session.GetString("Username")!</p>
                <p class="text-muted">Your order has been successfully placed and is being processed.</p>

                <div class="row mt-4">
                    <div class="col-md-6 mb-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6><i class="fas fa-envelope"></i> What's Next?</h6>
                                <p class="small mb-0">You will receive an email confirmation shortly with your order details.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6><i class="fas fa-shipping-fast"></i> Shipping</h6>
                                <p class="small mb-0">Your items will be shipped within 2-3 business days.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <a asp-controller="Order" asp-action="MyOrders" class="btn btn-primary me-2">
                        <i class="fas fa-list-alt"></i> View My Orders
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                        <i class="fas fa-shopping-bag"></i> Continue Shopping
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>